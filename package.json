{
  "name": "@vserv/icons",
  "version": "0.2.0",
  "description": "V-SERV Soft Depth dimensional and monochrome SVG React icon library",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/dimensional/*.d.ts",
      "import": "./dist/dimensional/*.js"
    },
    "./svg/*": "./svg/*",
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./package.json": "./package.json",
    "./depth": {
      "types": "./dist/depth.d.ts",
      "import": "./dist/depth.js"
    },
    "./line": {
      "types": "./dist/line.d.ts",
      "import": "./dist/line.js"
    },
    "./line/icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./dimensional/svg/*": "./dimensional/svg/*",
    "./renders/*": "./dimensional/renders/*",
    "./renders": {
      "types": "./dist/renders.d.ts",
      "import": "./dist/renders.js"
    },
    "./png/*": "./dimensional/png/*"
  },
  "files": [
    "dist",
    "svg",
    "icons.json",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "pilot-depth/svg",
    "dimensional",
    "preview"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs && node scripts/generate-depth.mjs && node scripts/generate-dimensional.mjs && node scripts/generate-gallery.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:visual": "node tests/visual.mjs",
    "audit": "node scripts/audit.mjs",
    "preview": "node scripts/serve.mjs",
    "prepack": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "~5.8.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "esbuild": "^0.25.0",
    "jsdom": "^27.4.0",
    "@playwright/test": "^1.65.0",
    "@axe-core/playwright": "^4.14.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrVXBoT/vserv-icons.git"
  },
  "homepage": "https://github.com/mrVXBoT/vserv-icons#readme",
  "bugs": {
    "url": "https://github.com/mrVXBoT/vserv-icons/issues"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "typescript",
    "dimensional",
    "monochrome"
  ]
}
